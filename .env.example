# ==============================================================================
# Magic Data Assistant - Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your actual credentials.
# Never commit your actual .env file to version control.
# ==============================================================================

# Google Gemini API Key (Get yours at https://aistudio.google.com/)
GOOGLE_API_KEY=your_google_api_key_here

# PostgreSQL / Neon Database Connection String
# e.g., postgresql://neondb_owner:password@host.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://username:password@host:5432/dbname?sslmode=require
NEON_CONNECTION_STRING=postgresql://username:password@host:5432/dbname?sslmode=require

# Gemini Model Selection (default: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Server Configuration
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=*
